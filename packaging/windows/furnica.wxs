<?xml version="1.0" encoding="utf-8"?>
<!--
  Instalatorul .msi pentru Windows 10/11 (WiX Toolset v5), construit de
  packaging/windows/msi.ps1 din dosarul pregătit de package.ps1.
  Textele din MSI sunt fără diacritice: MSI nu suportă UTF-8.
  UpgradeCode nu se schimbă niciodată: după el, o versiune nouă o înlocuiește pe cea veche.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Furnica" Manufacturer="nazdravan" Version="$(Version)"
           UpgradeCode="069C4AC2-EF25-4133-9D50-470401065F39" Scope="perMachine" Compressed="yes">
    <SummaryInformation Description="Furnica - executant pentru invatarea algoritmilor" />
    <MajorUpgrade DowngradeErrorMessage="O versiune mai noua a programului Furnica este deja instalata." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/nazdravan/furnica" />
    <Property Id="ARPHELPLINK" Value="https://github.com/nazdravan/furnica/issues" />

    <!-- C:\Program Files\Furnica (pe x86: Program Files (x86) pe un Windows pe 64 de biți). -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Furnica">
        <Component Id="MainExecutable">
          <File Id="MainExe" Source="$(Stage)\Furnica.exe" KeyPath="yes" />
          <!-- Dublu-click pe un fișier .ant îl deschide în Furnica. -->
          <ProgId Id="Furnica.Program" Description="Program Furnica" Icon="MainExe" IconIndex="0">
            <Extension Id="ant" ContentType="text/plain">
              <Verb Id="open" TargetFile="MainExe" Argument="&quot;%1&quot;" />
            </Extension>
          </ProgId>
        </Component>
        <Files Include="$(Stage)\*.txt" />
        <Directory Id="ExamplesFolder" Name="Exemple">
          <Files Include="$(Stage)\Exemple\*.ant" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="AppShortcut" Name="Furnica" Description="Furnica - executant pentru invatarea algoritmilor"
                  Target="[INSTALLFOLDER]Furnica.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKLM" Key="Software\nazdravan\Furnica" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
